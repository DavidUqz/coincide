{
  "name": "coincide",
  "version": "0.0.0",
  "private": true,
  "description": "Find the best meeting time for your team. Prefix-sum scheduling, no server, shareable by link.",
  "author": "David Urquiza",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "python3 -m http.server 5173 --directory src",
    "test": "node --test",
    "test:watch": "node --test --watch",
    "test:coverage": "node --test --experimental-test-coverage",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "bench": "node benchmarks/scheduler.bench.js",
    "check": "npm run lint && npm run format:check && npm test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "prettier": "3.10.1"
  }
}
